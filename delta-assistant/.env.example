# Copy to .env and fill in. NEVER commit .env. Never paste keys into chat.
# Keys must have TRADING permission only — NO withdrawal permission.

DELTA_API_KEY=
DELTA_API_SECRET=

# false = testnet (default, fake money). true = LIVE real money.
LIVE=false

# Base URLs (Delta India). Testnet needs its own account + its own keys.
DELTA_TESTNET_URL=https://cdn-ind.testnet.deltaex.org
DELTA_LIVE_URL=https://api.india.delta.exchange
