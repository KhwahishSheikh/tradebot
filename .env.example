# Copy to .env and fill in. NEVER commit .env.

# --- Delta Exchange (India) ---
DELTA_API_KEY=
DELTA_API_SECRET=

# --- Angel One SmartAPI ---
ANGEL_API_KEY=
ANGEL_CLIENT_CODE=
ANGEL_PIN=
ANGEL_TOTP_SECRET=

# --- Telegram (Ticket 11) ---
TELEGRAM_BOT_TOKEN=
# PIN you type in Telegram to confirm approvals in LIVE mode (6+ digits)
TELEGRAM_APPROVAL_PIN=

# --- Claude API for news classification (Ticket 6). Without it: keyword rules. ---
ANTHROPIC_API_KEY=

# Optional dead-man's switch (e.g. a free healthchecks.io check URL): alerts you if the whole
# VPS dies, which the in-host watchdog cannot detect.
HEALTHCHECKS_PING_URL=

# Second key for live trading. Live mode also needs mode: live + the confirm phrase in YAML.
TRADEBOT_ALLOW_LIVE=false
